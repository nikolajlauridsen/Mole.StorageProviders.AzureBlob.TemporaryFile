<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
      <Title>Azure Blob Storage Provider for Umbraco Temporary Files</Title>
      <Description>Azure Blob Storage provider for Umbraco temporary files. Offloads temporary file storage during media uploads and other operations to Azure Blob Storage.</Description>
      <Authors>Nikolaj E. Lauridsen</Authors>
      <IsPackable>true</IsPackable>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
      <PackageTags>umbraco;umbraco-marketplace</PackageTags>
      <NeutralLanguage>en-US</NeutralLanguage>
      <PackageProjectUrl>https://github.com/nikolajlauridsen/Mole.StorageProviders.AzureBlob.TemporaryFile</PackageProjectUrl>
      <RepositoryUrl>https://github.com/nikolajlauridsen/Mole.StorageProviders.AzureBlob.TemporaryFile</RepositoryUrl>
      <Version>19.0.0-beta1</Version>
      <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>    
    
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.28.0" />
    <PackageReference Include="Umbraco.Cms.Core" Version="[19.0.0-beta1,19.999.999]" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="[19.0.0-beta1,19.999.999]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
